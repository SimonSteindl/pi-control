<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pi_control_widget_bg"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="Pi Control Logo"
            android:scaleType="fitCenter"
            android:src="@drawable/pi_control_logo" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pi Control"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pi Control öffnen, um Daten zu laden"
                android:textColor="#AAB9D2"
                android:textSize="11sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="APP ÖFFNEN"
            android:textColor="#FFC857"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"
        android:background="#3B5274"
        android:importantForAccessibility="no"
        android:text="" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <LinearLayout style="@style/PiWidgetLargeMetric">
            <TextView style="@style/PiWidgetLargeLabel" android:text="PROZESSOR" />
            <TextView android:id="@+id/widget_cpu" style="@style/PiWidgetLargeValue" android:text="—%" />
        </LinearLayout>
        <LinearLayout style="@style/PiWidgetLargeMetric">
            <TextView style="@style/PiWidgetLargeLabel" android:text="ARBEITSSPEICHER" />
            <TextView android:id="@+id/widget_ram" style="@style/PiWidgetLargeValue" android:text="—%" />
        </LinearLayout>
        <LinearLayout style="@style/PiWidgetLargeMetric">
            <TextView style="@style/PiWidgetLargeLabel" android:text="TEMPERATUR" />
            <TextView android:id="@+id/widget_temperature" style="@style/PiWidgetLargeValue" android:text="— °C" />
        </LinearLayout>
        <LinearLayout style="@style/PiWidgetLargeMetric">
            <TextView style="@style/PiWidgetLargeLabel" android:text="SD-KARTE" />
            <TextView android:id="@+id/widget_sd" style="@style/PiWidgetLargeValue" android:text="—%" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
