{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pi-control-public",
  "compatibility_date": "2026-10-13",
  // Generates ./dist (only index.html, robots.txt, sitemap.xml) before every
  // `wrangler dev`, `wrangler deploy` and `wrangler deploy --dry-run`.
  "build": {
    "command": "python3 build.py"
  },
  "assets": {
    "directory": "./dist"
  }
}
