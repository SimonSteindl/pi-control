{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pi-control-dashboard",
  "main": "src/index.js",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
